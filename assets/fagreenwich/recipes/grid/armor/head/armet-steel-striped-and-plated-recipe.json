[
	// Armet with Everything
	{
    	"ingredientPattern": "B_C,DAE,___",
        "recipeGroup": 1,
        "ingredients": {
			"A": {	"type": "item", 
    				"code":"fagreenwich:head", 
				   	"attributes": {
  					"types": {
    					"formhead" : "armet",
    					"basehead" : "steel",
    					"coverhead" : "none",
    					"striphead" : "none",
    					"decorationhead" : "none",
    					"colorhead" : "none"}
  					} 
			},    
			"B": {  "type": "item", 
        			"code": "game:cloth-*", 
        			"name": "color", 
        			"allowedVariants": [
        				"plain",
    					"blue",
    					"red",
        				"yellow",
        				"green",
        				"purple",
        				"pink",                           
						"orange",
    					"brown",
    					"gray",
        				"black",
        				"white"
        			], 
        			"quantity": 2
    		},
			"C": {  "type": "item", 
    				"code": "facore:plumebase-*", 
        			"name": "plume", 
        			"allowedVariants": [
        				"crista",
        				"wings",
    					"crown"
    				]
    		},
			"D": {  "type": "item", 
    				"code": "game:metalplate-*", 
        			"name": "metalcover", 
        			"allowedVariants": [
        				"blackbronze",
        				"tinbronze",
    					"silver"
    				]
    		},
			"E": {  "type": "item", 
    				"code": "game:metalnailsandtrips-*", 
        			"name": "metalstrip", 
        			"allowedVariants": [
        				"blackbronze",
        				"tinbronze",
    					"silver"
    				]
    		}
		},
		"copyAttributesFrom": "A",
		"width": 3,
		"height": 3,
		"name": "Armet Decorating01",
		"output": {
 			"type": "item",
  			"code": "fagreenwich:head",
  			"attributes": {
  				"types": {
    				"formhead" : "armet",
    				"basehead" : "steel",
    				"coverhead" : "{metalcover}",
    				"striphead" : "{metalstrip}",
    				"decorationhead" : "{plume}",
    				"colorhead" : "{color}"
				}
            }
        }
    },

