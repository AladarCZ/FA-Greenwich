[
	//decorate all the helmets
	{
		"ingredientPattern": "B_C,_A_,___",
		"recipeGroup": 1,
		"ingredients": {
			"A": { 
				"type": "item", 
				"tags": { "allOf": ["fagreenwich-armet-no-decoration"] } 
			},
			"B": { 
				"type": "item", 
				"code": "facore:decorationkit-*", 
				"name": "color", 
				"allowedVariants": [
					"plain", 
					"blue", 
					"navy", 
					"red", 
					"rose", 
					"yellow", 
					"green", 
					"pine", 
					"purple", 
					"pink", 
					"burgundy",
					"orange", 
					"brown", 
					"gray", 
					"black", 
					"white"] 
			},
			"C": { 
				"type": "item", 
				"code": "facore:ornaments-communis-*", 
				"name": "plume", 
				"allowedVariants": [
					"crista", 
					"pennae", 
					"pluma"] 
			}
		},
		"copyAttributesFrom": "A",
		"width": 3,
		"height": 3,
		"name": "decorate any armet",
		"output": {
			"type": "item",
			"code": "fagreenwich:head",
			"attributes": {
				"types": {
					"decorationhead": "{plume}",
					"colorhead": "{color}"
				}
			}
		}
	},

	//trimm the iron helmets
