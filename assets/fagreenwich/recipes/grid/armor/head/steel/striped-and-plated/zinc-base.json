[
	// zinc plated Armet with plume (all the stripe variants)
	// zinc + copper
	{
    	"ingredientPattern": "B_C,_A_,___",
        "recipeGroup": 1,
        "ingredients": {
			"A": {	"type": "item", 
    				"code":"fagreenwich:head", 
				   	"attributes": {
  					"types": {
    					"formhead" : "armet",
    					"basehead" : "steel",
    					"coverhead" : "zinc",
    					"striphead" : "copper",
    					"decorationhead" : "none",
    					"colorhead" : "none"}
  					} 
			},    
			"B": {  "type": "item", 
        			"code": "facore:decorationkit-*", 
        			"name": "color", 
        			"allowedVariants": [
        				"plain",
    					"blue",
						"navy",
    					"red",
						"rose",
        				"yellow",
        				"green",
						"pine",
        				"purple",
        				"pink",
						"burgundy",                           
						"orange",
    					"brown",
    					"gray",
        				"black",
        				"white"
        			]
    		},
			"C": {  "type": "item", 
    				"code": "facore:ornaments-communis*", 
        			"name": "plume", 
        			"allowedVariants": [
        				"crista",
        				"pennae",
						"pluma"
    				]
    		}
		},
		"copyAttributesFrom": "A",
		"width": 3,
		"height": 3,
		"name": "Armet with Everything, even colors",
		"output": {
 			"type": "item",
  			"code": "fagreenwich:head",
  			"attributes": {
  				"types": {
    				"formhead" : "armet",
    				"basehead" : "steel",
    				"coverhead" : "zinc",
    				"striphead" : "copper",
    				"decorationhead" : "{plume}",
    				"colorhead" : "{color}"
				}
            }
        }
    },



