                        "flatDamagereduction": 3.2,
                        "highDamageTierResistant": true,
                        "protectionTier": 3
                    },
                    "basehead-iron": {
                        "relativeProtection": 0.97,
                        "flatDamagereduction": 3,
                        "highDamageTierResistant": true,
                        "protectionTier": 3
                    }
                },
                "statModifiers": {
                    "decorationhead-bear": {
                        "rangedWeaponsAcc": -0.15,
                        "rangedWeaponsSpeed": -0.25,
                        "walkSpeed": -0.14,
                        "healingeffectivness": -0.3334,
                        "hungerrate": 0.24
                    },
                    "*": {
                        "rangedWeaponsAcc": -0.15,
                        "rangedWeaponsSpeed": -0.25,
                        "walkSpeed": -0.12,
                        "healingeffectivness": -0.3334,
                        "hungerrate": 0.24
                    }
                },
                "description": {
                    "*": ["-----------------------------", "<br>",
                         ["Type: {0}", "formhead-{formhead}"], "<br>", 
                         ["Material: {0}", "basehead-{basehead}"], "<br>", 
                         ["Design: {0}", "decorationhead-{decorationhead}"], "<br>", 
                         ["Decoration: {0}", "colorhead-{colorhead}"], "<br>", 
                         ["Coating: {0}", "coverhead-{coverhead}"], "<br>", 
                         ["Trim: {0}", "striphead-{striphead}"], "<br>", 
                         "-----------------------------", "<br>"]
                },
                "STFA_attachableToEntity": {
                    "categoryCode": {
                        "*": "armorhead"
                    },
                    "disableElements": {
                        "*": ["hidehat", "Hood", "hoodupperover", "Hair tile upper part", "ponytailhigh", "ponytaillow", "Hair", "hair-uncovered", "hidefacialhair", "sidehigh", "sidelow", "bangs"]
                    }
