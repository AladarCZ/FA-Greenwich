        {
            "name": "AttributeRenderingLibrary.GenerateCreativeStacks",
            "properties": {
                "variantgroups": [
                    { "code": "formhead", "states": ["armet"] },
                    { "code": "basehead", "states": ["iron", "meteoriciron", "steel"] },
                    { "code": "coverhead", "states": ["none", "copper", "cupronikel", "brass", "zinc", "blackbronze", "lead", "silver", "meteoriciron", "gold", "electrum"] },
                    { "code": "striphead", "states": ["none", "copper", "cupronikel", "brass", "zinc", "blackbronze", "lead", "silver", "meteoriciron", "gold", "electrum"] },
                    { "code": "decorationhead", "states": ["none", "pennae", "pluma", "crista", "bear"] },
                    { "code": "colorhead", "states": ["none", "red", "rose", "green", "pine", "black", "blue", "navy", "brown", "white", "purple", "pink", "burghundy", "orange", "yellow", "gray", "plain"] }
                ],
                "tags":
                {
                    "formhead-armet::decorationhead-none": ["greenwich-helmet-nodecoration"]
                },
                "creativeinventory": {
                    "general": ["*"],
                    "fagreenwich": ["*"]
                },
                "allowedvariants": [
                    //Allow steel variants
                    "basehead-steel",

                    //Allow iron plain head and zinc-striped variant
                    "basehead-iron::coverhead-none::striphead-zinc",
                    "basehead-iron::coverhead-none::striphead-none",

                    //Allow meteoriciron plain head and cupronikel-striped variant
                    "basehead-meteoriciron::coverhead-none::striphead-cupronikel",                    
                    "basehead-meteoriciron::coverhead-none::striphead-brass",
                    "basehead-meteoriciron::coverhead-none::striphead-blackbronze",
                    "basehead-meteoriciron::coverhead-none::striphead-none",
                    
                    //Allow properly colored bear variants
                    "decorationhead-bear::colorhead-brown",
                    "decorationhead-bear::colorhead-black",
                    "decorationhead-bear::colorhead-white",
                    
                    //Allow decorations
                    "decorationhead-pennae",
                    "decorationhead-crista",
                    "decorationhead-pluma",
                    
                    //Allow just a single undecorated variant
                    "decorationhead-none::colorhead-none"
                    
                ],
                "skipvariants": [
                    //Block decorated "none" duplicates
                    "decorationhead-pennae::colorhead-none",
                    "decorationhead-crista::colorhead-none",
                    "decorationhead-pluma::colorhead-none"
                ]
            }
        },
        {
            "name": "AttributeRenderingLibrary.Wearable",
            "properties": {
                "textures": {
                    "coverhead-none::decorationhead-bear": {
                        "seraph": { "base": "game:block/transparent" },
                        "basehead": { "base": "fagreenwich:armor/entity/greenwich/base/{basehead}" },
                        "striphead": { "base": "facore:armor/entity/trim/{striphead}" },
                        "colorhead": { "base": "facore:armor/entity/bear/{colorhead}" }
                    },
                    "coverhead-*::decorationhead-bear": {
                        "seraph": { "base": "game:block/transparent" },
                        "basehead": { "base": "fagreenwich:armor/entity/greenwich/cover/{coverhead}" },
                        "striphead": { "base": "facore:armor/entity/trim/{striphead}" },
                        "colorhead": { "base": "facore:armor/entity/bear/{colorhead}" }
                    },
                    "coverhead-none": {
                        "seraph": { "base": "game:block/transparent" },
                        "basehead": { "base": "fagreenwich:armor/entity/greenwich/base/{basehead}" },
                        "striphead": { "base": "facore:armor/entity/trim/{striphead}" },
                        "colorhead": { "base": "facore:block/decoration/head/{colorhead}" }
                    },
                    "coverhead-*": {
                        "seraph": { "base": "game:block/transparent" },
                        "basehead": { "base": "fagreenwich:armor/entity/greenwich/cover/{coverhead}" },
                        "striphead": { "base": "facore:armor/entity/trim/{striphead}" },
                        "colorhead": { "base": "facore:block/decoration/head/{colorhead}" }
                    }
                },
                "shape": {
                    "*": { "base": "fagreenwich:entity/armor/greenwich/{formhead}/{decorationhead}head" }
                },
                "storageFlags": {
                    "*": 128
                },
                "shapeIgnoreElements": {
                    "*": ["hidehat", "Hood", "hoodupperover", "Hair tile upper part", "ponytailhigh", "ponytaillow", "Hair", "hair-uncovered", "hidefacialhair", "sidehigh", "sidelow", "bangs"]
                },
                "durability": {
                    "basehead-iron": 3700,
                    "basehead-meteoriciron": 4300,
                    "basehead-steel": 7000
                },
                "visibleDamageEffect": {
                    "*": true
                },
                "warmth": {
                    "decorationhead-bear::@colorhead-(black|brown)": 1,
                    "decorationhead-bear::@colorhead-white": 1.5
                },
                "clothesCategory": {
